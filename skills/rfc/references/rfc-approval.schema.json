{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-plugin.local/schemas/rfc-approval.json",
  "title": "PM RFC approval audit",
  "description": "v1 records original human approval; v2 retains historical owns-only human re-approval; v3 records reviewed maintenance inheriting the original human identity and exact prior audit, not new human approval.",
  "oneOf": [
    {
      "title": "v1 original approval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "slug",
        "status",
        "approved_by",
        "approved_at",
        "html_sha256",
        "sidecar_sha256",
        "approval_transition_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$" },
        "slug": { "type": "string", "minLength": 1 },
        "status": { "const": "approved" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "html_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sidecar_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approval_transition_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    {
      "title": "v2 amendment re-approval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "slug",
        "status",
        "approved_by",
        "approved_at",
        "html_sha256",
        "sidecar_sha256",
        "approval_transition_sha256",
        "amends",
        "amended_issue_nums",
        "reason"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "run_id": { "type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$" },
        "slug": { "type": "string", "minLength": 1 },
        "status": { "const": "approved" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "html_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sidecar_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approval_transition_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "amends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "approval_sha256", "sidecar_sha256", "html_sha256"],
          "properties": {
            "run_id": { "type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$" },
            "approval_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "sidecar_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "html_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "amended_issue_nums": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "v3 reviewed in-scope maintenance",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "slug",
        "status",
        "approved_by",
        "approved_at",
        "html_sha256",
        "sidecar_sha256",
        "approval_transition_sha256",
        "amends",
        "amended_issue_nums",
        "reason"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "run_id": { "type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$" },
        "slug": { "type": "string", "minLength": 1 },
        "status": { "const": "maintained" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "html_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sidecar_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approval_transition_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "amends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "approval_sha256", "sidecar_sha256", "html_sha256"],
          "properties": {
            "run_id": { "type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$" },
            "approval_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "sidecar_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "html_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "amended_issue_nums": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
