            "revision": {"type": "integer", "minimum": 1},
            "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "decision_id": {"type": "string", "minLength": 1},
            "decision_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
