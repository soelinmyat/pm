            "revision",
            "content_sha256",
            "proposal_snapshot_sha256",
            "approved_by",
            "approved_at",
            "technical_derivation",
            "implementation",
            "boundaries",
            "grant_sha256"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "kind": {"const": "bounded-product-delivery"},
            "groom_run_id": {"type": "string", "pattern": "^groom_[A-Za-z0-9_-]+$"},
            "groom_repo_root": {"type": "string", "minLength": 1},
            "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "proposal_id": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "proposal_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "approved_by": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "format": "date-time"},
            "technical_derivation": {"const": true},
            "implementation": {"const": true},
            "boundaries": {
              "const": ["product", "commercial", "security", "privacy", "operational"]
            },
            "grant_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    {
      "title": "v5 reviewed product-delegated delivery",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "slug",
        "status",
        "approved_by",
        "approved_at",
        "html_sha256",
        "sidecar_sha256",
        "approval_transition_sha256",
        "amends",
        "amended_issue_nums",
        "reason",
        "product_decision",
        "delivery_delegation"
      ],
      "properties": {
        "schema_version": {"const": 5},
        "run_id": {"type": "string", "pattern": "^rfc_[A-Za-z0-9_-]+$"},
        "slug": {"type": "string", "minLength": 1},
        "status": {"const": "maintained"},
        "approved_by": {"type": "string", "minLength": 1},
