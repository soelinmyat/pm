#!/usr/bin/env bash
# PostToolUse hook — logs pm: skill invocations when analytics is enabled.
# Fires after every Skill tool call. Checks the analytics flag, extracts the
# skill name from stdin JSON, delegates the `invoked` event to pm-log.sh, and
# starts a run — writing .current-run/.current-skill so the steps pipeline
# (hooks/agent-step, scripts/state-telemetry.js) can correlate spans to it.
# Run closing lives elsewhere: state-telemetry closes a run on explicit
# completion, and session-end closes any run still open at session end.

set -euo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-.}"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

# Check analytics flag — bail fast if disabled
ANALYTICS=$(sed -n 's/^analytics: *//p' "$PROJECT_DIR/.claude/pm.local.md" 2>/dev/null | head -1)
[ "$ANALYTICS" != "true" ] && exit 0

# Hook engagements are session-scoped. The helper reads session_id directly
# from the hook payload, preserves the previous engagement as the parent, and
# never turns a nested skill load into a workflow terminal.
cd "$PROJECT_DIR"
node "$PLUGIN_ROOT/scripts/analytics-session.js" start --project-dir "$PROJECT_DIR" || true
